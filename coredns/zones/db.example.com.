$ORIGIN example.com. ; base domain-name
$TTL 1d              ; default ttl

@            IN        SOA        ns.example.com. hostmaster.example.com. (
                                         2026090900 ; serial
                                         4h         ; refresh
                                         30m        ; retry
                                         4d         ; expiry
                                         1h         ; minimum
                                         )

@            IN        NS        ns1.example.com.
@            IN        NS        ns2.example.com.
@            IN        A         1.1.1.20

edge-dns     IN        A         1.1.1.10
ns           IN        A         1.1.1.10
ns1          IN        A         1.1.1.11
ns2          IN        A         1.1.1.12

edge-web     IN        A         1.1.1.20
www          IN        CNAME     edge-web
